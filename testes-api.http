Content-Type: application/json
Authorization: Bearer {{token}}

{
  "titulo": "Pão",
  "data": "2026-06-24",
  "valor": 20,
  "tipo": "DESPESA",
  "descricao": "pãozin",
  "categoriaNome": "Alimentação"
}

